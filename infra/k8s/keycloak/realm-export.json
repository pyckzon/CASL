{
  "realm": "casl",
  "enabled": true,
  "displayName": "CASL E-commerce",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard user"
      },
      {
        "name": "ADMIN",
        "description": "Administrator"
      }
    ]
  },
  "defaultRoles": [
    "USER"
  ],
  "clients": [
    {
      "clientId": "casl-gateway",
      "name": "CASL Gateway",
      "description": "Edge gateway (public client for browser/Postman)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://casl.local/*"
      ],
      "webOrigins": [
        "https://casl.local",
        "https://keycloak.casl.local"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "casl-users-service",
      "name": "CASL Users Service",
      "description": "Service account for users-service (confidential)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${KC_CASL_USERS_SECRET}",
      "protocol": "openid-connect"
    },
    {
      "clientId": "casl-order-service",
      "name": "CASL Order Service",
      "description": "Service account for order-to-payment calls (confidential)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${KC_CASL_ORDER_SECRET}",
      "protocol": "openid-connect"
    }
  ],
  "users": []
}