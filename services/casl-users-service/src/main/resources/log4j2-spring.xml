<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!-- JsonTemplateLayout con event template PII: el resolver custom "piiMessage"
                 enmascara emails/teléfonos del campo message antes de emitir el JSON. -->
            <JsonTemplateLayout eventTemplateUri="classpath:casl-log-event-pii.json">
                <EventTemplateAdditionalField key="service" value="${spring:spring.application.name}"/>
            </JsonTemplateLayout>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
